Edition=xiaojiaoben
标题=微信加人-节奏清单(只打印不动微信)
启动热键=F9键
暂停/继续热键=
终止热键=F12键
简介=读名单逐条打印待加的人/搜索号/验证语，随机间隔。不调用任何窗口操作命令，不碰微信。

// ==============================================================
//  这个脚本【只做三件事】：读名单 -> 逐条打印「该加谁 / 用哪个号搜 / 说什么话」-> 随机等一会儿
//  它不打开微信、不找窗口、不点按钮、不读内存。所有操作由你自己去微信里做。
//  所以运行它不构成「第三方程序操控微信客户端」——因为压根没碰客户端。
// --------------------------------------------------------------
//  【禁止用在微信上的命令】（本脚本一个都没用，列出来只当反面清单）
//    打开进程 / 关闭进程            —— 抓微信进程
//    找图 / 找色 / 找字 / 找图辅助线  —— 在微信窗口里认按钮
//    后台点击 / 后台按键 / 模拟按键   —— 往微信里注入操作
//    读内存整数型 / 写内存 / 读内存文本型 —— 改微信运行时数据（这条最严重）
//    网页访问 / 网页打开             —— 走非官方入口
//  前四条是「模拟人在点」，最后一条是「改软件内部」，性质完全不同。
//  本脚本只用这批「纯文本/纯流程」命令：
//    读入文本 (路径, 存放变量)              读整个文件
//    文本取行数 (文本, 存放变量)            数一共有几行
//    读指定文本行 (路径, 行数, 存放变量)    取第 N 行
//    运算 (变量=表达式)                     算 / 拼字符串 / 调内置函数
//      内置：生成指定随机数字(最小,最大)、分割文本(文本,标识)
//    如果(条件,层) / 否则(层) / 条件结束(层)   三件套，缺一不可
//    计次循环(总量,下标,组名) / 计次循环结束(组名)
//    标记(名) / 跳转标记(名)
//    延时(毫秒)
//    调试(变量...)                          只在编辑器界面输出，编译成 exe 后失效
//    写到文件 (路径, 内容)
//    取时间_小时(变量) / 取时间_分钟(变量)
// --------------------------------------------------------------
//  【编码注意】小脚本编辑器按 ANSI(GBK) 读 .sfq，所以这个文件是 GBK 编码的，别另存成 UTF-8。
//  【运行方式】用 小脚本4.86.exe 打开本文件 -> 编辑器里按 F9。
//              输出全在下方「调试输出」框，同时写一份 今日清单.txt。
//              不要点「生成/发布」编译成 exe，编译后 调试 命令就没了。
// ==============================================================

// 自定义变量：写一行就能在编辑器里改默认值（下方 调试 输出时可直接双击改）
// 演练倍数=40 是为了试跑把节奏压到 6~10 秒；正式用改成 1，就是真节奏 240~420 秒
自定义变量(演练倍数=40);
变量(名单,总行,i,本行,字段,目标名,搜索号,电话号,渠道,验证语,搜索用,等待秒,等待毫秒,小时数,分钟数,提示,清单);

子程序(主程序);
 // ===== 1. 看时间，过了 22 点就不走了（如果-否则-条件结束 + 标记/跳转标记）=====
 取时间_小时(小时数);
 取时间_分钟(分钟数);
 运算(提示="现在 " + 小时数 + ":" + 分钟数);
 调试(提示);
 如果(小时数 > 22, 晚档);
  运算(提示="今天够晚了，加人通过率最低，明天再来");
  调试(提示);
  跳转标记(收工);
 否则(晚档)
  运算(提示="开始走清单，微信你自己开");
  调试(提示);
 条件结束(晚档)

 // ===== 2. 读名单，数一数今天排了几个人 =====
 读入文本("名单.txt", 名单);
 文本取行数(名单, 总行);
 运算(提示="今天排队 " + 总行 + " 个人");
 调试(提示);
 运算(清单="");

 // ===== 3. 一人一行，逐条打出来（计次循环 + 分割文本）=====
 //    名单.txt 每行格式：目标#微信号#电话#渠道#验证语
 计次循环(总行, i, 组1);
  读指定文本行("名单.txt", i, 本行);
  运算(字段=分割文本(本行,"#"));
  运算(目标名=字段[1]);
  运算(搜索号=字段[2]);
  运算(电话号=字段[3]);
  运算(渠道=字段[4]);
  运算(验证语=字段[5]);
  // 搜索框一次只能敲一个：有微信号就搜微信号，没有才搜电话
  如果(搜索号 = "", 用电话);
    运算(搜索用=电话号);
  否则(用电话)
    运算(搜索用=搜索号);
  条件结束(用电话)
  // 两个都空的，说明这行没填全，标出来让你回头补
  如果(搜索号 = "" 且 电话号 = "", 缺号);
    运算(提示=目标名 + " 微信号和电话都没填，搜不着人，回头补一眼");
    调试(提示);
  否则(缺号)
    运算(提示=目标名 + " | 敲：" + 搜索用 + " | " + 渠道 + " | 话：" + 验证语);
    调试(提示);
    运算(清单=清单 + 目标名 + " " + 搜索用 + " " + 渠道 + " " + 验证语 + #换行);
  条件结束(缺号)
  // 随机间隔：240~420 秒之间不等距，乘演练倍数是为了好试跑（改成 1 就是真节奏）
  运算(等待秒=生成指定随机数字(240,420));
  运算(等待毫秒=等待秒 * 1000 * 演练倍数);
  延时(等待毫秒);
 计次循环结束(组1)

 // ===== 4. 把清单落盘，方便照着表格点 =====
 写到文件("今日清单.txt", 清单);
 运算(提示="清单写进 今日清单.txt 了");
 调试(提示);

标记(收工);
运算(提示="收工。上面只是清单，微信那头还是你自己动手加。");
调试(提示);
运算(提示="提醒两句：验证语别照抄，把真名字真场景填进去；加完当天聊两句，别上来就发广告。");
调试(提示);
运算(提示="真被限制加好友时，停几天 + 正常聊几天通常就回来了，别拿新号第一天就怼。");
调试(提示);
